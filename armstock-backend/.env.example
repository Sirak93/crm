PORT=4200
# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:4201

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
# Optional: empty when the local Postgres needs no password
DB_PASSWORD=
DB_NAME=armstock
# Schema auto-sync. Only the exact value "true" enables it - set it in development (MVP).
DB_SYNCHRONIZE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=
# Access token lifetime, seconds. Kept short so a turned-off/logged-out user is locked out fast.
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=
# Refresh token lifetime, seconds.
JWT_REFRESH_EXPIRES_IN=86400

# Used only by `npm run seed` to create the Platform Owner.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# `npm run seed:dev` runs only when this is "development".
NODE_ENV=

# Used only by `npm run seed:dev` - the demo company's logins, all with the same password.
DEV_SEED_PASSWORD=
DEV_SEED_OWNER_EMAIL=
DEV_SEED_STOREKEEPER_EMAIL=
DEV_SEED_ACCOUNTANT_EMAIL=
DEV_SEED_HR_EMAIL=

ENABLE_LOGS=true

# One row per API request in the api_logs table. Only the exact value "true" enables it.
API_DB_LOG_ENABLED=true
# Requests at/above this duration (ms) are flagged slow in api_logs.
SLOW_REQUEST_THRESHOLD_MS=1000
