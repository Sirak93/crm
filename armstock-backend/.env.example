PORT=4200
# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:4201

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
# Optional: empty when the local Postgres needs no password
DB_PASSWORD=
DB_NAME=armstock
# Schema auto-sync. Only the exact value "true" enables it - set it in development (MVP).
DB_SYNCHRONIZE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

ENABLE_LOGS=true

# One row per API request in the api_logs table. Only the exact value "true" enables it.
API_DB_LOG_ENABLED=true
# Requests at/above this duration (ms) are flagged slow in api_logs.
SLOW_REQUEST_THRESHOLD_MS=1000
