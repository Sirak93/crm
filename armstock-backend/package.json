{
  "name": "armstock-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:shared && ts-node-dev --respawn --transpile-only src/server.ts",
    "build:shared": "npm run build -w armstock-shared",
    "build": "npm run build:shared && tsc",
    "start": "node dist/server.js",
    "seed": "npm run build:shared && ts-node src/seeders/seed.ts",
    "seed:dev": "npm run build:shared && ts-node src/seeders/seedDev.ts",
    "seed:company-data": "npm run build:shared && ts-node --transpile-only src/seeders/seedCompanyData.ts",
    "lint": "tsc --noEmit",
    "test": "npm run build:shared && ts-node --transpile-only src/scripts/tester/Run.ts",
    "test:company": "npm run build:shared && ts-node --transpile-only src/scripts/tester/Run.ts company",
    "test:rate-limits": "npm run build:shared && ts-node --transpile-only src/scripts/tester/Run.ts rate-limits",
    "test:platform": "npm run build:shared && ts-node --transpile-only src/scripts/tester/Run.ts platform"
  },
  "dependencies": {
    "armstock-shared": "*",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "rate-limit-redis": "^6.0.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
